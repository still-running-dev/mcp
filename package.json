{
  "name": "@still-running/mcp",
  "version": "0.1.1",
  "description": "MCP server exposing stillrunning.dev's workflow analysis to Claude Desktop, Claude Code, and Cursor.",
  "homepage": "https://stillrunning.dev",
  "bugs": {
    "url": "https://github.com/still-running-dev/mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/still-running-dev/mcp.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "still-running-mcp": "dist/cli.js"
  },
  "directories": {
    "test": "test"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@still-running/health-check": "2.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
